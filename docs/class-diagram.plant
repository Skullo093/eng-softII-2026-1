@startuml "FechaConta"
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam shadowing true
skinparam roundcorner 15
skinparam linetype ortho
skinparam packageStyle rectangle

hide empty members

title Sistema de Controle Financeiro

' ==================================================
' ENUMS
' ==================================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
}

enum FormaPagamento {
  CONTA_CORRENTE
  CARTAO_CREDITO
  PIX
  DINHEIRO
}

enum TipoCategoria {
  RECEITA
  DESPESA
}

' ==================================================
' USUÁRIOS
' ==================================================

abstract class Usuario {
  -id: int
  -nome: String
  -email: String
  -senha: String
  -dataCadastro: Date

  +login(): boolean
  +alterarSenha(): void
}

class PessoaFisica {
  -cpf: String
  -dataNascimento: Date
}

class PessoaJuridica {
  -cnpj: String
  -razaoSocial: String
}

Usuario <|-- PessoaFisica
Usuario <|-- PessoaJuridica

' ==================================================
' CONTA
' ==================================================

class Conta {
  -id: int
  -nomeBanco: String
  -agencia: String
  -numeroConta: String
  -saldoAtual: double
  -tipoConta: String

  +consultarSaldo(): double
  +depositar(valor): void
  +sacar(valor): void
}

Usuario "1" -- "0..*" Conta

' ==================================================
' CARTÃO
' ==================================================

class CartaoCredito {
  -id: int
  -nomeCartao: String
  -limiteTotal: double
  -limiteDisponivel: double
  -diaFechamento: int
  -diaVencimento: int
  -status: String

  +gerarFatura(): void
  +consultarLimite(): double
}

class Fatura {
  -id: int
  -mesReferencia: String
  -valorTotal: double
  -dataVencimento: Date
  -status: StatusPagamento

  +fecharFatura(): void
  +pagarFatura(): void
}

Usuario "1" -- "0..*" CartaoCredito
CartaoCredito "1" -- "0..*" Fatura

' ==================================================
' CATEGORIA
' ==================================================

class Categoria {
  -id: int
  -nome: String
  -tipo: TipoCategoria

  +criarCategoria(): void
}

class Subcategoria {
  -id: int
  -nome: String

  +criarSubcategoria(): void
}

Categoria "1" -- "0..*" Subcategoria

' ==================================================
' TRANSAÇÕES
' ==================================================

abstract class Transacao {
  -id: int
  -descricao: String
  -valor: double
  -dataTransacao: Date
  -dataVencimento: Date
  -tipoMovimentacao: TipoMovimentacao
  -formaPagamento: FormaPagamento
  -statusPagamento: StatusPagamento
  -recorrente: boolean
  -afetaSaldoConta: boolean

  +registrar(): void
  +cancelar(): void
}

class Receita {
  -fonteReceita: String
}

class Despesa {
  -prioridade: String
  -parcelada: boolean
  -quantidadeParcelas: int

  +calcularParcelas(): void
  +pagar(): void
}

Transacao <|-- Receita
Transacao <|-- Despesa

Conta "1" -- "0..*" Receita
Conta "1" -- "0..*" Despesa

Fatura "1" -- "0..*" Despesa

Categoria "1" -- "0..*" Transacao
Subcategoria "1" -- "0..*" Transacao

' ==================================================
' NOTIFICAÇÕES
' ==================================================

class Notificacao {
  -id: int
  -mensagem: String
  -dataAlerta: Date
  -visualizada: boolean
  -tipoAlerta: String

  +enviar(): void
}

Transacao "1" -- "0..*" Notificacao

' ==================================================
' METAS
' ==================================================

class MetaFinanceira {
  -id: int
  -descricao: String
  -valorObjetivo: double
  -valorAtual: double
  -prazoFinal: Date
  -status: String

  +atualizarProgresso(): void
  +concluirMeta(): void
}

Usuario "1" -- "0..*" MetaFinanceira

' ==================================================
' PLANEJAMENTO
' ==================================================

class PlanejamentoFinanceiro {
  -id: int
  -mesReferencia: String
  -previsaoReceita: double
  -limiteGastos: double
  -saldoPrevisto: double

  +calcularSaldoPrevisto(): double
}

Usuario "1" -- "0..*" PlanejamentoFinanceiro
PlanejamentoFinanceiro "1" -- "0..*" Transacao

' ==================================================
' CONFIGURAÇÕES
' ==================================================

class Configuracoes {
  -id: int
  -tema: String
  -moedaPadrao: String
  -notificacoesAtivas: boolean

  +salvarConfiguracoes(): void
}

Usuario "1" -- "1" Configuracoes

@enduml